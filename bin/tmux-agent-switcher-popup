#!/usr/bin/env bash
# Opens the agent sidebar in a full-screen tmux popup.
#
# Usage: tmux-agent-switcher-popup <window_id> <session_name> [down|up]
#
# The optional direction is kept for custom bindings that want to pre-move the
# list selection. The default tmux entrypoint opens without a pre-move so the
# current window remains selected. window_id/session_name are passed in already
# expanded by tmux so the popup highlights the window the key was pressed from.
set -euo pipefail

window_id="${1:-}"
session_name="${2:-}"
direction="${3:-}"

# View style / input mode: the last toggled value (stored by the switcher for
# the tmux server's lifetime) wins over the configured default.
view="$(tmux show-option -gqv '@tmux_agent_switcher_view')"
if [[ -z "${view}" ]]; then
  view="$(tmux show-option -gqv '@agent_switcher_view')"
fi
input="$(tmux show-option -gqv '@tmux_agent_switcher_input')"
if [[ -z "${input}" ]]; then
  input="$(tmux show-option -gqv '@agent_switcher_input')"
fi

args=(
  -B -E -w 100% -h 100%
  -e "TMUX_AGENT_SWITCHER_CURRENT=${window_id}"
  -e "TMUX_AGENT_SWITCHER_SESSION=${session_name}"
)
if [[ -n "${direction}" ]]; then
  args+=(-e "TMUX_AGENT_SWITCHER_INITIAL_MOVE=${direction}")
fi
if [[ -n "${view}" ]]; then
  args+=(-e "TMUX_AGENT_SWITCHER_VIEW=${view}")
fi
if [[ -n "${input}" ]]; then
  args+=(-e "TMUX_AGENT_SWITCHER_INPUT=${input}")
fi

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
exec tmux display-popup "${args[@]}" "${script_dir}/tmux-agent-switcher"
