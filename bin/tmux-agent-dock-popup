#!/usr/bin/env bash
# Opens the agent sidebar in a full-screen tmux popup.
#
# Usage: tmux-agent-dock-popup <window_id> <session_name> [down|up] [--view <mode>]
#
# The optional direction is kept for custom bindings that want to pre-move the
# list selection. The default tmux entrypoint opens without a pre-move so the
# current window remains selected. window_id/session_name are passed in already
# expanded by tmux so the popup highlights the window the key was pressed from.
#
# `--view` pins one opening to a layout, so a binding can mean "the palette"
# rather than "whatever the last toggle left behind". Without it the stored and
# configured view still decide, as before.
set -euo pipefail

view_override=""
positional=()
while (( $# )); do
  case "$1" in
    --view) view_override="${2:-}"; shift 2 ;;
    --view=*) view_override="${1#--view=}"; shift ;;
    *) positional+=("$1"); shift ;;
  esac
done

window_id="${positional[0]:-}"
session_name="${positional[1]:-}"
direction="${positional[2]:-}"

# View style / input mode: the last toggled value (stored by the switcher for
# the tmux server's lifetime) wins over the configured default.
#
# Read in one round trip rather than four. Every `tmux` invocation here sits
# between the keypress and the popup's first frame, and the popup is *blank*
# until that frame lands — so each round trip is 7ms of visible flash. Measured
# on 3.7b: four `show-option` calls cost 30ms, this one costs 8ms.
IFS='|' read -r stored_view configured_view stored_input configured_input <<<"$(
  tmux display-message -p \
    '#{@tmux_agent_dock_view}|#{@agent_dock_view}|#{@tmux_agent_dock_input}|#{@agent_dock_input}'
)" || true

view="${stored_view:-${configured_view}}"
input="${stored_input:-${configured_input}}"

# An explicit --view outranks both, so the key that asked for a palette gets one.
if [[ -n "${view_override}" ]]; then
  view="${view_override}"
fi

args=(
  # `-s bg=default` is what keeps the opening from flashing: a popup is drawn
  # the moment tmux creates it, but the TUI's first frame is ~50ms later, and in
  # between it is a solid rectangle in the popup's own colour. Painting it in the
  # terminal's background instead makes that gap invisible rather than a flash.
  -B -E -w 100% -h 100% -s bg=default
  -e TMUX_AGENT_DOCK_NO_STALE_CHECK=1
  -e "TMUX_AGENT_DOCK_CURRENT=${window_id}"
  -e "TMUX_AGENT_DOCK_SESSION=${session_name}"
)
if [[ -n "${direction}" ]]; then
  args+=(-e "TMUX_AGENT_DOCK_INITIAL_MOVE=${direction}")
fi
if [[ -n "${view}" ]]; then
  args+=(-e "TMUX_AGENT_DOCK_VIEW=${view}")
fi
if [[ -n "${input}" ]]; then
  args+=(-e "TMUX_AGENT_DOCK_INPUT=${input}")
fi

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
exec tmux display-popup "${args[@]}" "${script_dir}/tmux-agent-dock"
